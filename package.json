{
  "name": "moe-music",
  "version": "1.0.0",
  "description": "Artemis - Music Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "mobile:prepare": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('index.html','www/index.html')\"",
    "mobile:sync": "npm run mobile:prepare && cap sync android",
    "mobile:build": "npm run mobile:sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.moe.music",
    "productName": "Artemis",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3"
  }
}
