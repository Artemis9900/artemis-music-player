{
  "name": "moe-music",
  "version": "1.0.0",
  "description": "Artemis - Music Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.moe.music",
    "productName": "Artemis",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
